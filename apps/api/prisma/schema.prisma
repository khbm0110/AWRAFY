// انظر docs/03-database-schema.md — هاد الملف مصدر الحقيقة، أي تغيير هنا خصو يتعكس هناك
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  plan      String   @default("free")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  users  User[]
  stores Store[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  passwordHash String @map("password_hash")
  role      String   // owner, staff, admin

  // 2FA — انظر docs/07-security-checklist.md "Merchant Account Security"
  totpSecret         String?  @map("totp_secret")
  totpEnabled        Boolean  @default(false) @map("totp_enabled")
  totpRecoveryCodes  String[] @map("totp_recovery_codes")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Store {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  name              String
  theme             Json?
  defaultLocale     String   @default("ar") @map("default_locale")
  supportedLocales  String[] @default(["ar", "fr", "en"]) @map("supported_locales")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("stores")
}

model Category {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  parentId String? @map("parent_id")
  name     Json // {"ar": "...", "fr": "...", "en": "..."} — انظر docs/06-i18n-guidelines.md
  slug     String

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  categoryId  String?  @map("category_id")
  title       Json // i18n JSONB — إجباري بالضبط بحال docs/03-database-schema.md
  description Json?
  slug        String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  status      String   @default("draft") // draft, active, archived
  createdAt   DateTime @default(now()) @map("created_at")

  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  orderItems OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("products")
}

model ProductVariant {
  id         String @id @default(uuid())
  productId  String @map("product_id")
  sku        String?
  stock      Int    @default(0)
  attributes Json? // {"color": "red", "size": "M"}

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Customer {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  email         String?
  phone         String?
  name          String?
  trustScore    Decimal @default(1.00) @map("trust_score") @db.Decimal(3, 2)
  loyaltyPoints Int     @default(0) @map("loyalty_points")

  orders Order[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model Order {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  customerId      String?  @map("customer_id")
  status          String   @default("pending") // pending, confirmed, shipped, delivered, cancelled
  total           Decimal  @db.Decimal(10, 2)
  idempotencyKey  String?  @unique @map("idempotency_key") // إجباري لمنع التكرار
  createdAt       DateTime @default(now()) @map("created_at")

  customer      Customer?          @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  confirmations OrderConfirmation[]
  shipments     Shipment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id") // اختياري — منتج بلا variants يقدر يبقى NULL
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  method          String // cod, cmi, card
  status          String   @default("pending")
  amount          Decimal  @db.Decimal(10, 2)
  webhookVerified Boolean  @default(false) @map("webhook_verified")
  createdAt       DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// تأكيد الطلب قبل الشحن — ضروري لـCOD فالمغرب، انظر docs/03-database-schema.md
model OrderConfirmation {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  channel     String // whatsapp, sms, call
  status      String    @default("pending") // pending, confirmed, no_response, rejected
  sentAt      DateTime  @default(now()) @map("sent_at")
  confirmedAt DateTime? @map("confirmed_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_confirmations")
}

model ShippingCarrier {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String // Ozonexpress, Ilamex, Aramex, DHD, Crono...
  apiConfig Json?    @map("api_config") // credentials/endpoint — ⚠️ خصها تشفير at-rest
  active    Boolean  @default(true)

  shipments Shipment[]

  @@index([tenantId])
  @@map("shipping_carriers")
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  carrierId      String?  @map("carrier_id")
  trackingNumber String?  @map("tracking_number")
  status         String   @default("pending") // مؤتمت عبر webhook/polling من الشركة
  statusHistory  Json     @default("[]") @map("status_history")

  order   Order            @relation(fields: [orderId], references: [id])
  carrier ShippingCarrier? @relation(fields: [carrierId], references: [id])

  @@index([orderId])
  @@map("shipments")
}

model Subscription {
  id                String    @id @default(uuid())
  tenantId          String    @unique @map("tenant_id") // اشتراك وحد فعّال لكل tenant
  planKey           String    @map("plan_key") // starter, growth, pro — انظر modules/billing/plans.ts
  status            String    @default("trialing") // trialing, active, past_due, cancelled
  trialEndsAt       DateTime? @map("trial_ends_at")
  currentPeriodEnd  DateTime  @map("current_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")

  invoices PlatformInvoice[]

  @@map("subscriptions")
}

model PlatformInvoice {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id")
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("MAD")
  status         String    @default("pending") // pending, paid, failed
  pdfUrl         String?   @map("pdf_url") // ⚠️ TODO: توليد PDF حقيقي عبر BullMQ job
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime  @map("period_end")
  issuedAt       DateTime  @default(now()) @map("issued_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("platform_invoices")
}

// Stock Adjustments — حل جزئي لمشكل المحل الفيزيائي، انظر docs/03-database-schema.md
model StockAdjustment {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  variantId       String   @map("variant_id")
  quantityChange  Int      @map("quantity_change")
  reason          String // offline_sale, damaged, manual_correction, restock
  note            String?
  actorId         String?  @map("actor_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([variantId])
  @@map("stock_adjustments")
}
